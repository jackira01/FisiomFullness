# Database Configuration
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Configuration
JWT_secret=your_jwt_secret_key_here_replace_with_secure_value

# Cloudinary Configuration
cloud_name=your_cloudinary_cloud_name
api_key=your_cloudinary_api_key
api_secret=your_cloudinary_api_secret

# Mailjet Configuration (Email Service)
MJ_APIKEY_PUBLIC=your_mailjet_public_api_key
MJ_APIKEY_PRIVATE=your_mailjet_private_api_key
MJ_API_TOKEN=your_mailjet_api_token

# Email Configuration
EMAIL_SENDER=your_email@example.com
APP_NAME=Fisium Fulness

# Application Configuration
APP_URL=http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:3000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173

# Google Maps Geocoding API (necesaria para el endpoint GET /users/geocode)
# Activar "Geocoding API" en https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
